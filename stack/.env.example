# 复制为 .env 并填入你的配置。start.sh / start.bat 会自动载入。
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# .env 已被 .gitignore 忽略，不会提交到仓库 —— 请勿把它发给别人。

# ============ 拆层后端 ============
# hf | hf-nf4 | modelscope | local
#   local     有 NVIDIA 显卡 → 完全本地、无需令牌、无额度限制（推荐）
#   modelscope 国内直连，约 26 分钟（慢在排队）
#   hf         ZeroGPU，约 2.7 分钟，需能访问外网
SEETHROUGH_BACKEND=modelscope

# ============ 在线令牌（local 后端不需要）============
# HuggingFace（免费，可选）: https://huggingface.co/settings/tokens
HF_TOKEN=

# ModelScope（免费，必填才能用 modelscope 后端）: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_TOKEN=

# ============ 本地 see-through（SEETHROUGH_BACKEND=local 时必填）============
# 完整步骤见 docs/LOCAL_SEETHROUGH.md
#
# see-through 仓库的绝对路径
# SEETHROUGH_REPO=/path/to/see-through
#
# 装了 torch(CUDA) 的那个 Python 解释器（关键！填错会报 ModuleNotFoundError）
# 用 `conda activate see_through && which python`（Windows: where python）取得
# SEETHROUGH_LOCAL_PYTHON=/path/to/miniconda3/envs/see_through/bin/python
#
# 本地推理超时（秒），默认 7200。低显存 + offload 很慢时可调大
# SEETHROUGH_LOCAL_TIMEOUT=10800

# ============ 超时与其他 ============
# 在线推理超时（秒），默认 900。ModelScope 排队较久，建议 2700
# SEETHROUGH_TIMEOUT=2700

# 服务端口（默认 8770）
# PORT=8770

# psd2live 产物目录（自动探测失败时手动指定）
# PSD2LIVE_APP=/path/to/PSD2Live
# 或直接指定 java 可执行文件
# PSD2LIVE_JAVA=/path/to/java
